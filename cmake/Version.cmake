# Version.txt is the single product version source. Configuring never increments it.
function(read_version version_file)
  if(NOT EXISTS "${version_file}")
    message(FATAL_ERROR "Missing version file: ${version_file}")
  endif()
  file(READ "${version_file}" version)
  string(STRIP "${version}" version)
  if(NOT version MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "Expected four numeric version components: ${version}")
  endif()
  string(REPLACE "." ";" components "${version}")
  foreach(component IN LISTS components)
    if(component GREATER 65535)
      message(FATAL_ERROR "Windows version components must be <= 65535")
    endif()
  endforeach()
  set(CURRENT_VERSION "${version}" PARENT_SCOPE)
  set(UPDATED_VERSION "${version}" PARENT_SCOPE)
endfunction()

function(increment_version version_file)
  read_version("${version_file}")
  string(REPLACE "." ";" components "${CURRENT_VERSION}")
  list(POP_BACK components build)
  if(build EQUAL 65535)
    message(FATAL_ERROR "Build version is exhausted; update Version.txt manually")
  endif()
  math(EXPR build "${build} + 1")
  list(APPEND components "${build}")
  list(JOIN components "." version)
  file(WRITE "${version_file}" "${version}\n")
  message(STATUS "Package version: ${CURRENT_VERSION} -> ${version}")
  set(UPDATED_VERSION "${version}" PARENT_SCOPE)
endfunction()

# Explicit invocation by the packaging entry point, once before configure.
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(NOT DEFINED VERSION_FILE)
    message(FATAL_ERROR "VERSION_FILE is required")
  endif()
  increment_version("${VERSION_FILE}")
endif()
