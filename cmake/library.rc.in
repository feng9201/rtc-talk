1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "hxf"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "Copyright hxf (Suzhou)."
            VALUE "OriginalFilename", "@RTCWIN_RESOURCE_FILENAME@"
            VALUE "ProductName", "rtc-talk-win"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
            VALUE "FileDescription", "@RTCWIN_RESOURCE_NAME@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
