set(RTC_LOG_SDK_ROOT "${CMAKE_CURRENT_LIST_DIR}/../third_party/log-cpp")
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "No verified log SDK binary is available for this OS yet")
endif()
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
  set(_rtc_log_platform linux-aarch64)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$")
  set(_rtc_log_platform linux-x86_64)
else()
  message(FATAL_ERROR "Unsupported log SDK architecture")
endif()
set(_rtc_log_library "${RTC_LOG_SDK_ROOT}/lib/${_rtc_log_platform}/librtc_log_adapter.so.1.0.0")
if(NOT EXISTS "${_rtc_log_library}" OR NOT EXISTS "${RTC_LOG_SDK_ROOT}/include/rtc_log_adapter.h")
  message(FATAL_ERROR "Verified log SDK binary missing. Rebuild with scripts/build-log-sdk.sh; no source fallback is allowed.")
endif()
add_library(rtc_log_sdk SHARED IMPORTED GLOBAL)
file(READ "${RTC_LOG_SDK_ROOT}/${_rtc_log_platform}.json" _rtc_log_manifest)
string(JSON _rtc_log_abi GET "${_rtc_log_manifest}" abi)
string(JSON _rtc_log_sha GET "${_rtc_log_manifest}" library_sha256)
string(JSON _rtc_log_header_sha GET "${_rtc_log_manifest}" header_sha256)
file(SHA256 "${_rtc_log_library}" _rtc_log_actual_sha)
file(SHA256 "${RTC_LOG_SDK_ROOT}/include/rtc_log_adapter.h" _rtc_log_actual_header_sha)
if(NOT _rtc_log_abi EQUAL 1 OR NOT _rtc_log_actual_sha STREQUAL _rtc_log_sha OR
   NOT _rtc_log_actual_header_sha STREQUAL _rtc_log_header_sha)
  message(FATAL_ERROR "log SDK ABI/checksum mismatch: update the binary, header and manifest together")
endif()
set_target_properties(rtc_log_sdk PROPERTIES IMPORTED_LOCATION "${_rtc_log_library}"
  IMPORTED_SONAME librtc_log_adapter.so.1
  INTERFACE_INCLUDE_DIRECTORIES "${RTC_LOG_SDK_ROOT}/include")
