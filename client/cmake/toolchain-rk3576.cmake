set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(RK3576_HOST "$ENV{RK3576_HOST}" CACHE PATH "Buildroot 宿主工具链目录")
if(NOT RK3576_HOST OR NOT EXISTS "${RK3576_HOST}/bin/aarch64-buildroot-linux-gnu-g++")
  message(FATAL_ERROR "请设置 RK3576_HOST 为有效的 Buildroot host 目录")
endif()
set(CMAKE_C_COMPILER "${RK3576_HOST}/bin/aarch64-buildroot-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "${RK3576_HOST}/bin/aarch64-buildroot-linux-gnu-g++")
set(CMAKE_SYSROOT "${RK3576_HOST}/aarch64-buildroot-linux-gnu/sysroot")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
list(APPEND CMAKE_PREFIX_PATH "${CMAKE_SYSROOT}/usr/lib/cmake")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES RK3576_HOST)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
