if(NOT EXISTS "${MEDIA_LIBRARY}" OR NOT EXISTS "${READELF}")
  message(FATAL_ERROR "Media linkage verification requires the library and toolchain readelf")
endif()
execute_process(COMMAND "${READELF}" -d "${MEDIA_LIBRARY}"
  RESULT_VARIABLE _result OUTPUT_VARIABLE _dynamic ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect media dynamic dependencies")
endif()
if(_dynamic MATCHES "NEEDED[^\n]*lib(ssl|crypto)\\.so")
  message(FATAL_ERROR "Media/BoringSSL must not depend on system OpenSSL")
endif()
execute_process(COMMAND "${READELF}" --dyn-syms --wide "${MEDIA_LIBRARY}"
  RESULT_VARIABLE _result OUTPUT_VARIABLE _symbols ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect media dynamic symbols")
endif()
string(REPLACE "\n" ";" _lines "${_symbols}")
set(_factory_found FALSE)
foreach(_line IN LISTS _lines)
  if(_line MATCHES "(GLOBAL|WEAK)[ \t]+DEFAULT[ \t]+([0-9]+|ABS)[ \t]+([^ \t]+)")
    set(_symbol "${CMAKE_MATCH_3}")
    if(_symbol MATCHES "^_ZN10rtc_client5media17make_webrtc_audio")
      set(_factory_found TRUE)
    elseif(NOT _symbol MATCHES "^(_ZTI|_ZTS)N10rtc_client5media5ErrorE(@@RTC_AUDIO_1)?$" AND
           NOT _symbol STREQUAL "RTC_AUDIO_1")
      message(FATAL_ERROR "Unexpected media export: ${_symbol}")
    endif()
  endif()
endforeach()
if(NOT _factory_found)
  message(FATAL_ERROR "Media factory export is missing")
endif()
message(STATUS "Media isolation verified: no system OpenSSL dependency; exports restricted")
