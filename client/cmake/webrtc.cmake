set(WEBRTC_SOURCE_DIR "$ENV{WEBRTC_SOURCE_DIR}" CACHE PATH "匹配的 WebRTC 源码")
set(WEBRTC_BUILD_DIR "$ENV{WEBRTC_BUILD_DIR}" CACHE PATH "WebRTC 非 LTO 输出目录")
foreach(path "${WEBRTC_SOURCE_DIR}/api/peer_connection_interface.h" "${WEBRTC_BUILD_DIR}/obj/libwebrtc.a" "${WEBRTC_BUILD_DIR}/args.gn")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "缺少 WebRTC SDK 文件：${path}")
  endif()
endforeach()
file(READ "${WEBRTC_BUILD_DIR}/args.gn" webrtc_args)
foreach(setting "use_thin_lto = false" "use_custom_libcxx = false" "use_elf_crel = false")
  string(FIND "${webrtc_args}" "${setting}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "GCC 接入要求 ${setting}，请勿混用 SDK 构建")
  endif()
endforeach()
add_library(talk_webrtc INTERFACE)
target_include_directories(talk_webrtc SYSTEM INTERFACE "${WEBRTC_SOURCE_DIR}" "${WEBRTC_SOURCE_DIR}/third_party/abseil-cpp" "${WEBRTC_SOURCE_DIR}/third_party/libyuv/include")
target_compile_definitions(talk_webrtc INTERFACE WEBRTC_POSIX WEBRTC_LINUX WEBRTC_ARCH_ARM64 WEBRTC_HAS_NEON RTC_ENABLE_H265 WEBRTC_INCLUDE_INTERNAL_AUDIO_DEVICE RTC_DISABLE_TRACE_EVENTS WEBRTC_ENABLE_PROTOBUF=0 WEBRTC_EXCLUDE_BUILT_IN_SSL_ROOT_CERTS WEBRTC_STRICT_FIELD_TRIALS=0 WEBRTC_NON_STATIC_TRACE_EVENT_HANDLERS=0 WEBRTC_DEPRECATE_PLAN_B DYNAMIC_ANNOTATIONS_ENABLED=0 NDEBUG)
target_link_libraries(talk_webrtc INTERFACE "${WEBRTC_BUILD_DIR}/obj/libwebrtc.a" Threads::Threads dl m)
